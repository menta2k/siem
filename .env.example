# Copy to .env and fill in. Every variable below is REQUIRED unless marked optional.
# Services fail fast at startup if a required value is missing (Constitution: secrets
# validated at startup). Never commit a filled-in .env.

# ---------- ClickHouse ----------
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DATABASE=siem
CLICKHOUSE_USERNAME=siem
CLICKHOUSE_PASSWORD=
CLICKHOUSE_MAX_EXECUTION_TIME_SECONDS=10
CLICKHOUSE_MAX_OPEN_CONNS=32

# ---------- Redpanda (Kafka API) ----------
REDPANDA_BROKERS=redpanda:9092
REDPANDA_TOPIC_RAW=siem.events.raw
REDPANDA_TOPIC_NORMALIZED=siem.events.normalized
REDPANDA_TOPIC_DLQ=siem.events.dlq
REDPANDA_PRODUCE_TIMEOUT_MS=5000

# ---------- Redis ----------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Auth ----------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
JWT_SIGNING_KEY=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168
MFA_ISSUER=SIEM

# ---------- Secret manager ----------
# Feed credentials are stored by reference, never inline. "env" is for local
# development only; use "vault" or "aws-sm" in any shared environment.
SECRET_BACKEND=env
SECRET_BACKEND_ENDPOINT=
SECRET_BACKEND_TOKEN=

# ---------- Service ports ----------
API_HTTP_PORT=8000
INGEST_HTTP_PORT=8001
PROCESSOR_HTTP_PORT=8002
METRICS_BIND=0.0.0.0

# ---------- Limits ----------
INGEST_MAX_BODY_BYTES=33554432
INGEST_MAX_BATCH_EVENTS=50000
QUERY_MAX_RESULT_ROWS=1000
QUERY_MAX_RANGE_DAYS=90
EXPORT_MAX_ROWS=100000

# ---------- Correlation defaults (per-tenant values override these) ----------
CORRELATION_WINDOW_MS=5000
CORRELATION_LATENESS_BOUND_MS=900000

# ---------- Observability ----------
LOG_LEVEL=info
LOG_FORMAT=json
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
REDPANDA_KAFKA_PORT=9092
REDPANDA_ADMIN_PORT=9644
REDIS_HOST_PORT=6379
