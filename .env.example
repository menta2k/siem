# Copy to .env and fill in. Every variable below is REQUIRED unless marked optional.
# Services fail fast at startup if a required value is missing (Constitution: secrets
# validated at startup). Never commit a filled-in .env.

# ---------- ClickHouse ----------
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DATABASE=siem
CLICKHOUSE_USERNAME=siem
CLICKHOUSE_PASSWORD=
CLICKHOUSE_MAX_EXECUTION_TIME_SECONDS=10
CLICKHOUSE_MAX_OPEN_CONNS=32

# ---------- Redpanda (Kafka API) ----------
REDPANDA_BROKERS=redpanda:9092
REDPANDA_TOPIC_RAW=siem.events.raw
REDPANDA_TOPIC_NORMALIZED=siem.events.normalized
REDPANDA_TOPIC_DLQ=siem.events.dlq
REDPANDA_PRODUCE_TIMEOUT_MS=5000

# ---------- Redis ----------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Auth ----------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
JWT_SIGNING_KEY=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168
MFA_ISSUER=SIEM

# ---------- Secret manager ----------
# Feed credentials are stored by reference, never inline. "env" is for local
# development only; use "vault" or "aws-sm" in any shared environment.
SECRET_BACKEND=env
SECRET_BACKEND_ENDPOINT=
SECRET_BACKEND_TOKEN=

# ---------- Service ports ----------
API_HTTP_PORT=8000
INGEST_HTTP_PORT=8001
PROCESSOR_HTTP_PORT=8002
METRICS_BIND=0.0.0.0

# ---------- Limits ----------
INGEST_MAX_BODY_BYTES=33554432
INGEST_MAX_BATCH_EVENTS=50000
# How long the durable commit may take AFTER the sender has stopped waiting. Cloudflare
# Logpush disconnects from a slow destination, and abandoning a half-published batch is
# what makes it retry the same batch forever -- so the commit finishes on its own clock.
INGEST_COMMIT_TIMEOUT_SECONDS=120
QUERY_MAX_RESULT_ROWS=1000
QUERY_MAX_RANGE_DAYS=90
EXPORT_MAX_ROWS=100000

# ---------- Correlation defaults (per-tenant values override these) ----------
CORRELATION_WINDOW_MS=5000
CORRELATION_LATENESS_BOUND_MS=900000

# ---------- AS-number to owner lookup ----------
# Names the network behind a client's ASN, so the console shows "AS8866 VIVACOM-AS"
# rather than a bare number. The processor downloads the table from iptoasn.com (public
# domain, PDDL v1.0) on start and then on the interval below.
#
# This is the ONLY scheduled outbound connection the platform makes. Set ENABLED=false
# for an air-gapped deployment: everything still works, ASNs simply stay unnamed. A
# failed download keeps the last good table and logs a warning.
ASN_OWNERS_ENABLED=true
ASN_OWNERS_REFRESH_HOURS=24
# Override only to point at a mirror. Must be https.
# ASN_OWNERS_SOURCE_URL=https://iptoasn.com/data/ip2asn-combined.tsv.gz

# ---------- Observability ----------
LOG_LEVEL=info
LOG_FORMAT=json
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
REDPANDA_KAFKA_PORT=9092
REDPANDA_ADMIN_PORT=9644
REDIS_HOST_PORT=6379

# ---------- Cloudflare Tunnel (production edge) ----------
# Connector token from Zero Trust -> Networks -> Tunnels -> your tunnel -> Install.
# With this set, `docker compose --profile tunnel up -d` publishes the console through
# Cloudflare and the host needs no inbound port at all. Leave empty to run without it.
CLOUDFLARE_TUNNEL_TOKEN=

# Where the published ports bind. Once the tunnel is verified, set BOTH to 127.0.0.1:
# the tunnel reaches the services over the compose network, so nothing needs to be
# listening on a public interface. That is the whole point of running one — an encrypted
# open port is still an open port.
WEB_PUBLISH_ADDR=0.0.0.0
INGEST_PUBLISH_ADDR=0.0.0.0
