# Production image for the Vue SPA: built once, then served as static files.
#
# The Compose stack runs the Vite dev server instead, which is right for development
# and wrong for anything else — it ships an unminified bundle and a file watcher. This
# is the artefact a deployment actually runs.

# Pinned to the NATIVE platform. The bundle this stage produces is just JavaScript and
# CSS — identical on every architecture — so building it per target platform gains
# nothing and costs a full npm install plus a Vite build running under QEMU emulation,
# which is minutes per extra architecture. Only the nginx stage below is arch-specific.
FROM --platform=$BUILDPLATFORM node:22-alpine AS build
WORKDIR /app

# The lockfile is copied first so a dependency install is only redone when dependencies
# actually change, not on every source edit.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# schema.d.ts is generated by `npm run gen:api` and committed, so the build needs only
# the frontend tree — the contract file itself is not read here.
COPY frontend/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
# The upstream the /api proxy points at. Overridable so the same image works in Compose,
# in Kubernetes, and behind an external gateway.
ENV API_UPSTREAM=http://siem-api:8000
# Vendor deliveries. Kept on the ingest service rather than the API so a delivery flood
# cannot contend with the analyst-facing surface.
ENV INGEST_UPSTREAM=http://siem-ingest:8001
# Docker's embedded DNS. Override for Kubernetes (kube-dns.kube-system.svc.cluster.local)
# or any other environment whose resolver is elsewhere.
ENV DNS_RESOLVER=127.0.0.11

COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf

EXPOSE 8080
