# Copy to .env and fill in. Never commit a filled-in file.

# The F5 feed's ingest endpoint. The vendor segment is `f5`; the id is the feed you
# created in the SIEM console (Feeds -> Add feed -> vendor F5).
SIEM_INGEST_URL=https://siem.server-lab.eu/ingest/v1/f5/REPLACE-WITH-FEED-ID

# The feed's ingest token, shown once when the feed was created or rotated
# (Feeds -> Rotate token). Stored as an unrecoverable reference by the platform, so if
# it is lost, rotate rather than hunt for it.
SIEM_FEED_TOKEN=REPLACE-WITH-FEED-TOKEN

# The interface BIG-IP reaches this collector on. Deliberately defaults to loopback:
# syslog is unauthenticated, so anything able to reach this port can forge WAF events
# into your SIEM. Set it to the LAN address BIG-IP will send to, never 0.0.0.0.
SYSLOG_BIND=10.0.0.5
SYSLOG_PORT=5514
